{
  "name": "solid-floating-ui",
  "version": "1.0.0",
  "private": false,
  "description": "SolidJS bindings for Floating UI",
  "keywords": [
    "dropdown",
    "floating-ui",
    "menu",
    "popover",
    "popup",
    "positioning",
    "solid-js",
    "tooltip"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-floating-ui/tree/main/packages/solid-floating-ui",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-floating-ui/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-floating-ui.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./dist/index.jsx",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.jsx"
    },
    "./utils": {
      "solid": "./dist/utils.jsx",
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.jsx"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsdown",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:dev": "vite --config e2e/vite.config.ts",
    "type-check": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@floating-ui/utils": "^0.2.9",
    "tabbable": "^6.2.0"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@playwright/test": "^1.62.1",
    "@solidjs/vite-plugin": "^3.0.0-next.38",
    "@solidjs/web": "^2.0.0-rc.6",
    "@types/node": "^24.7.0",
    "solid-js": "^2.0.0-rc.6",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.5",
    "@solidjs/web": "^2.0.0-rc.0",
    "solid-js": "^2.0.0-rc.0"
  },
  "engines": {
    "node": ">=18"
  }
}
